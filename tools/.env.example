# tools/.env 의 예시.
# 실제 키 입력 후 파일명을 .env 로 변경. 절대 commit X (.gitignore 에 등록됨).
#
# Anthropic 키 발급: https://console.anthropic.com/settings/keys
# 신규 가입 시 $5 무료 크레딧.

# 필수
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXX

# 선택 (기본 claude-sonnet-4-6)
# 옵션: claude-sonnet-4-6 (균형, ~$0.5/강) / claude-opus-4-7 (고품질, ~$2.5/강) / claude-haiku-4-5 (저렴, ~$0.1/강)
ANTHROPIC_MODEL=claude-sonnet-4-6

# 선택 (기본 16000)
# 강의 1개당 최대 출력 토큰. 너무 작으면 자료 잘림.
# ANTHROPIC_MAX_TOKENS=16000
